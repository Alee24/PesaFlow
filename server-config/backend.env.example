# Backend Environment Variables
# Copy this to: /var/www/mpesaconnect.co.ke/backend/.env

# Server Configuration
PORT=3002
NODE_ENV=production

# Database Configuration
DATABASE_URL="mysql://root:@localhost:3306/pesaflow"

# JWT Configuration
JWT_SECRET="your-secret-key-here-change-this-in-production"

# M-Pesa Configuration
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_SHORTCODE="174379"
MPESA_INITIATOR_NAME="testapi"
MPESA_INITIATOR_PASSWORD="your-initiator-password"
MPESA_ENV="sandbox"

# Callback URLs
MPESA_CALLBACK_URL="https://mpesaconnect.co.ke/api/mpesa/callback"

# SMTP Configuration (Global - Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"
SMTP_FROM_NAME="Mpesa Connect"
SMTP_FROM_EMAIL="your-email@gmail.com"
